# ==========================================================
#  WHATSAPP COLMADO - Variables de entorno (copiar a .env)
# ==========================================================

# ---- Servidor ----
NODE_ENV=development
PORT=3000
WS_PORT=3001
LOG_LEVEL=info

# ---- Seguridad ----
JWT_SECRET=cambia_este_secreto_super_seguro
JWT_EXPIRES_IN=8h
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---- Base de datos ----
# DB_DRIVER: "mssql" para SQL Server real, "memory" para demo/pruebas sin BD
DB_DRIVER=memory
DB_HOST=localhost
DB_PORT=1433
DB_NAME=ColmadoDB
DB_USER=sa
DB_PASSWORD=Your_password123
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10
DB_POOL_MIN=0

# ---- WhatsApp ----
# WHATSAPP_PROVIDER: "baileys" | "cloud" | "console" (simulado)
WHATSAPP_PROVIDER=console
# Baileys
BAILEYS_AUTH_DIR=./auth_info_baileys
# WhatsApp Cloud API (Meta)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_VERIFY_TOKEN=mi_verify_token
WHATSAPP_CLOUD_API_VERSION=v20.0

# ---- Inteligencia Artificial (NLU) ----
# AI_PROVIDER: "rules" (sin costo, offline) | "openai"
AI_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Speech-to-text e imagen (opcional, usa OpenAI si está configurado)
AI_ENABLE_VOICE=false
AI_ENABLE_IMAGE=false

# ---- Impresora térmica ESC/POS ----
# PRINTER_DRIVER: "network" (TCP) | "file" (guarda ticket .bin/.txt) | "noop"
PRINTER_DRIVER=file
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100
PRINTER_WIDTH=42
PRINTER_OUTPUT_DIR=./tickets

# ---- Negocio ----
BUSINESS_NAME=COLMADO LA ESPERANZA
BUSINESS_PHONE=809-000-0000
BUSINESS_ADDRESS=Calle Principal #1, Santo Domingo
CURRENCY=RD$
ITBIS_RATE=0.0
DEFAULT_DELIVERY_FEE=100
